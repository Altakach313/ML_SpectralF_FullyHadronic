Main:numberOfEvents = {nevents}
Main:timesAllowErrors = 5

Init:showChangedSettings = off
Init:showChangedParticleData = off

Next:numberShowInfo = 1
Next:numberShowProcess = 1
Next:numberShowEvent = 1

Beams:frameType = 4
